[
    {
        "title": "Application parameters",
        "content": [
            {
                "title": "The tracker namespace",
                "parameter": "tna",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#application-parameters",
                "description": "The tracker namespace parameter is used to distinguish between different trackers. The name can be any string that does not contain a colon or semi-colon character. Tracker namespacing allows you to run multiple trackers, pinging to different collectors.",
                "table": [
                    [
                        "type:",
                        "text"
                    ],
                    [
                        "column_name:",
                        "name_tracker"

                    ],
                    [
                        "example value:",
                        "tracker_1"

                    ]
                ]
            },
            {
                "title": "Application ID",
                "parameter": "aid",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#application-parameters",
                "description": "Unique identifier for website / application",
                "table": [
                    [
                        "type:",
                        "text"
                    ],
                    [
                        "column_name:",
                        "app_id"

                    ],
                    [
                        "example value:",
                        "snow-game-android"

                    ]
                ]
            },
            {
                "title": "Platform",
                "parameter": "p",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#application-parameters",
                "description": "The platform the app runs on",
                "table": [
                    [
                        "type:",
                        "text"
                    ],
                    [
                        "column_name:",
                        "platform"

                    ],
                    [
                        "example value:",
                        "web"

                    ],
                    [
                        "allowed values:",
                        "web, mob, pc, srv, app, tv, cnsl, iot"
                    ]
                ]
            },
            {
                "title": "Tracker version",
                "parameter": "tv",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#application-parameters",
                "description": "Identifier for Snowplow tracker",
                "table": [
                    [
                        "type:",
                        "text"
                    ],
                    [
                        "column_name:",
                        "v_tracker"

                    ],
                    [
                        "example value:",
                        "js-3.0.0"

                    ]
                ]
            }
        ]
    },
    {
        "title": "Timestamp parameters",
        "content": [
            {
                "title": "Device created timestamp",
                "parameter": "dtm",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#timestamp-parameters",
                "description": "Timestamp when event occurred, as recorded by client device",
                "table": [
                    [
                        "type:",
                        "int"
                    ],
                    [
                        "column_name:",
                        "dvce_created_tstamp"

                    ],
                    [
                        "example value:",
                        "1361553733313"

                    ]
                ]
            },
            {
                "title": "Device sent timestamp",
                "parameter": "stm",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#timestamp-parameters",
                "description": "Timestamp when event was sent by client device to collector",
                "table": [
                    [
                        "type:",
                        "int"
                    ],
                    [
                        "column_name:",
                        "dvce_sent_tstamp"

                    ],
                    [
                        "example value:",
                        "1361553733371"

                    ]
                ]
            },
            {
                "title": "True timestamp",
                "parameter": "ttm",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#timestamp-parameters",
                "description": "User-set exact timestamp",
                "table": [
                    [
                        "type:",
                        "int"
                    ],
                    [
                        "column_name:",
                        "true_tstamp"

                    ],
                    [
                        "example value:",
                        "1361553733371"

                    ]
                ]
            },
            {
                "title": "Operating System timezone",
                "parameter": "tz",
                "tna": "https://docs.snowplow.io/docs/collecting-data/collecting-from-own-applications/snowplow-tracker-protocol/#timestamp-parameters",
                "description": "Time zone of client devices OS",
                "table": [
                    [
                        "type:",
                        "text"
                    ],
                    [
                        "column_name:",
                        "os_timezone"

                    ],
                    [
                        "example value:",
                        "Europe%2FLondon"

                    ]
                ]
            }
        ]
    }
]
